{# Dependency CVE lookup results (V1.2) — populated by cve_lookup.py
   Hidden entirely when no CVE data was provided. #}
{% if cve_findings_count and cve_findings_count > 0 %}
<section id="dep-cve" class="space-y-6">
  <div class="flex items-center gap-2">
    <span class="w-1.5 h-6 rounded-full bg-gradient-to-b from-violet-500 to-violet-700"></span>
    <h2 class="text-xl font-bold tracking-tight">第三方依赖 CVE 在线扫描</h2>
  </div>

  <div class="flex flex-wrap items-center gap-2 text-xs">
    {% set source_label = {
      'osv-online':    '数据源：OSV.dev 在线',
      'offline-cache': '数据源：离线缓存（payloads/vulnerable-ranges.json）',
      'mixed':         '数据源：在线 + 离线缓存混合',
      'none':          '数据源：未扫描'
    }.get(cve_source, '数据源：未知') %}
    <span class="inline-flex items-center gap-1 px-2 py-1 rounded-full
                 bg-violet-100 text-violet-700
                 font-semibold">
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <path d="M12 2 4 7v6c0 5 3.5 8.5 8 9 4.5-.5 8-4 8-9V7l-8-5Z"/>
      </svg>
      {{ source_label }}
    </span>
    <span class="px-2 py-1 rounded-full bg-slate-100 text-slate-600 font-mono">
      共扫描 {{ cve_queries_total }} 个第三方依赖
    </span>
    <span class="px-2 py-1 rounded-full bg-slate-100 text-slate-600 font-mono">
      命中 {{ cve_findings_count }} 条 advisory
    </span>
    {% if cve_queries_cached %}
    <span class="px-2 py-1 rounded-full bg-slate-100 text-slate-600 font-mono">
      离线缓存命中 {{ cve_queries_cached }}
    </span>
    {% endif %}
    {% if cve_queries_failed %}
    <span class="px-2 py-1 rounded-full bg-amber-100 text-amber-700 font-mono">
      在线失败 {{ cve_queries_failed }}
    </span>
    {% endif %}
  </div>

  <details class="bg-white border border-rose-200 rounded-2xl shadow-sm overflow-hidden" open>
    <summary class="cursor-pointer px-6 py-4 font-semibold text-sm flex items-center justify-between">
      <span class="flex items-center gap-2">
        <svg class="w-4 h-4 text-rose-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M12 9v4M12 17h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"/>
        </svg>
        第三方依赖 CVE（按严重度排序 · {{ cve_findings_count }} 条）
      </span>
      <span class="text-xs text-slate-400">点击折叠 / 展开</span>
    </summary>
    <div class="px-6 pb-6">
      <table class="section-table">
        <thead>
          <tr>
            <th>依赖</th>
            <th>版本</th>
            <th>严重度</th>
            <th>CVE</th>
            <th>固定版本</th>
            <th>简介</th>
            <th>引用</th>
          </tr>
        </thead>
        <tbody>
          {% for c in cve_findings %}
          <tr>
            <td class="font-mono">
              <div class="flex flex-col gap-0.5">
                <span class="text-violet-700">{{ c.name }}</span>
                <span class="text-[10px] uppercase tracking-wide text-slate-400">{{ c.ecosystem }}</span>
                <span class="text-[10px] text-slate-400 break-all">{{ c.manifest or '—' }}</span>
              </div>
            </td>
            <td class="font-mono text-xs">{{ c.version }}</td>
            <td>
              {% set sev = c.severity or 'Unknown' %}
              <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-semibold
                {% if sev == 'Critical' %}bg-rose-100 text-rose-700
                {% elif sev == 'High' %}bg-orange-100 text-orange-700
                {% elif sev == 'Medium' %}bg-amber-100 text-amber-700
                {% elif sev == 'Low' %}bg-cyan-100 text-cyan-700
                {% else %}bg-slate-100 text-slate-700{% endif %}">
                <span class="sev-dot {{ sev }}"></span>{{ sev }}
                {% if c.cvss_score %}<span class="text-[10px] opacity-70 ml-1 font-mono">{{ c.cvss_score }}</span>{% endif %}
              </span>
            </td>
            <td class="text-xs">
              {% if c.cve_id %}
                <a href="{{ c.nvd_url or c.advisory_url or '#' }}"
                   target="_blank" rel="noopener"
                   class="inline-block px-1.5 py-0.5 rounded bg-rose-50
                          text-rose-700 font-mono mr-1 hover:underline">
                  {{ c.cve_id }}
                </a>
              {% endif %}
              {% if c.ghsa %}
              <span class="inline-block px-1.5 py-0.5 rounded bg-slate-100 text-slate-600 font-mono text-[10px]">
                {{ c.ghsa[0] }}
              </span>
              {% endif %}
              {% if c.source == 'offline-cache' %}
              <span class="ml-1 inline-block px-1 py-0.5 rounded bg-amber-100 text-amber-700 text-[10px] font-semibold"
                    title="本次审计在离线模式下完成，部分结果可能为缓存数据">离线缓存</span>
              {% endif %}
            </td>
            <td class="font-mono text-xs">
              {% if c.fixed_version and c.fixed_version != '—' %}
                <span class="inline-flex flex-wrap gap-1">
                  {% for v in c.fixed_versions or [] %}
                    <span class="px-1.5 py-0.5 rounded bg-emerald-50 text-emerald-700 font-mono">{{ v }}</span>
                  {% endfor %}
                </span>
              {% else %}
                <span class="text-slate-400">—</span>
              {% endif %}
            </td>
            <td class="text-xs text-slate-600 max-w-md">{{ c.summary or '—' }}</td>
            <td class="text-xs">
              {% if c.advisory_url %}
              <a href="{{ c.advisory_url }}" target="_blank" rel="noopener"
                 class="inline-flex items-center gap-1 text-violet-600 hover:underline font-semibold">
                OSV →
              </a>
              {% endif %}
              {% if c.nvd_url and c.nvd_url != c.advisory_url %}
              <a href="{{ c.nvd_url }}" target="_blank" rel="noopener"
                 class="inline-flex items-center gap-1 text-violet-600 hover:underline font-semibold ml-2">
                NVD →
              </a>
              {% endif %}
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </details>
</section>
{% endif %}
