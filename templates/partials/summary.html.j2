{# Executive summary #}
<section id="summary" class="grid lg:grid-cols-3 gap-6">
  <div class="lg:col-span-2 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-7 shadow-sm">
    <div class="flex items-center gap-2 mb-4">
      <span class="w-1.5 h-6 rounded-full bg-gradient-to-b from-violet-500 to-violet-700"></span>
      <h2 class="text-xl font-bold tracking-tight">执行摘要</h2>
    </div>
    <div class="prose prose-slate dark:prose-invert max-w-none text-sm leading-relaxed">
      <p>{{ executive_summary_intro | safe }}</p>
      {% if partial %}
      <div class="not-prose mt-4 p-3 rounded-lg bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-800/50 text-amber-900 dark:text-amber-200 text-sm">
        ⚠ <strong>注意：</strong>本次审计因 token 预算受限未完成全部代码扫描，结果可能不完整。建议扩大预算后重审。
      </div>
      {% endif %}
      {% if snippet_mode %}
      <div class="not-prose mt-4 p-3 rounded-lg bg-orange-50 dark:bg-orange-950/30 border border-orange-200 dark:border-orange-800/50 text-orange-900 dark:text-orange-200 text-sm">
        ⚠ <strong>代码片段审计模式</strong> — 没有文件树 / 调用链上下文，所有 finding 的 confidence 已自动下调。
      </div>
      {% endif %}
    </div>
  </div>

  <aside class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-6 shadow-sm">
    <h3 class="text-sm font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400 mb-4">关键发现 Top 5</h3>
    {% if top_findings %}
    <ol class="space-y-3">
      {% for f in top_findings %}
      <li class="flex gap-3 group">
        <span class="flex-shrink-0 w-6 h-6 rounded-full bg-slate-100 dark:bg-slate-800 grid place-items-center text-xs font-bold text-slate-500 dark:text-slate-400">{{ loop.index }}</span>
        <div class="flex-1 min-w-0">
          <a href="#{{ f.id }}" class="text-sm font-medium text-slate-900 dark:text-slate-50 group-hover:text-violet-700 dark:group-hover:text-violet-300 line-clamp-2 leading-snug">{{ f.title }}</a>
          <div class="flex items-center gap-2 mt-1 text-xs">
            <span class="sev-dot {{ f.severity }}"></span>
            <span class="font-semibold text-slate-600 dark:text-slate-400">{{ f.severity }}</span>
            {% if f.cvss_score %}<span class="text-slate-400">· CVSS {{ f.cvss_score }}</span>{% endif %}
            <span class="text-slate-400 truncate">· {{ f.file_path }}{% if f.file_line %}:{{ f.file_line }}{% endif %}</span>
          </div>
        </div>
      </li>
      {% endfor %}
    </ol>
    {% else %}
    <p class="text-sm text-slate-500 dark:text-slate-400">未发现漏洞。</p>
    {% endif %}
  </aside>
</section>