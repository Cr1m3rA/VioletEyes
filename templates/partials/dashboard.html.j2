{# Dashboard — severity chart + class chart + coverage #}
<section id="dashboard" class="space-y-6">
  <div class="flex items-center gap-2">
    <span class="w-1.5 h-6 rounded-full bg-gradient-to-b from-violet-500 to-violet-700"></span>
    <h2 class="text-xl font-bold tracking-tight">风险仪表盘</h2>
  </div>

  <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
    <div class="stat-card border-l-4 !border-l-rose-600">
      <div class="stat-label flex items-center"><span class="sev-dot Critical"></span>Critical</div>
      <div class="stat-value text-rose-600 mt-2">{{ counts.critical }}</div>
    </div>
    <div class="stat-card border-l-4 !border-l-orange-500">
      <div class="stat-label flex items-center"><span class="sev-dot High"></span>High</div>
      <div class="stat-value text-orange-600 mt-2">{{ counts.high }}</div>
    </div>
    <div class="stat-card border-l-4 !border-l-amber-500">
      <div class="stat-label flex items-center"><span class="sev-dot Medium"></span>Medium</div>
      <div class="stat-value text-amber-600 mt-2">{{ counts.medium }}</div>
    </div>
    <div class="stat-card border-l-4 !border-l-cyan-600">
      <div class="stat-label flex items-center"><span class="sev-dot Low"></span>Low</div>
      <div class="stat-value text-cyan-600 mt-2">{{ counts.low }}</div>
    </div>
    <div class="stat-card border-l-4 !border-l-slate-500">
      <div class="stat-label flex items-center"><span class="sev-dot Informational"></span>Info</div>
      <div class="stat-value text-slate-600 mt-2">{{ counts.info }}</div>
    </div>
  </div>

  <div class="charts-grid grid lg:grid-cols-2 gap-6">
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-6 shadow-sm">
      <h3 class="text-sm font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400 mb-4">风险等级分布</h3>
      <div class="h-72"><canvas id="severityChart"></canvas></div>
    </div>
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-6 shadow-sm">
      <h3 class="text-sm font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400 mb-4">漏洞类型 Top 10</h3>
      <div class="h-72"><canvas id="classChart"></canvas></div>
    </div>
  </div>

  <div class="grid md:grid-cols-3 gap-4">
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-5 shadow-sm">
      <div class="text-xs uppercase tracking-wide text-slate-500 dark:text-slate-400">覆盖率</div>
      <div class="mt-2 flex items-baseline gap-2">
        <span class="text-3xl font-bold tracking-tight">{{ coverage_pct }}%</span>
        <span class="text-xs text-slate-500 dark:text-slate-400">({{ tested_assets }} / {{ total_assets }})</span>
      </div>
      <div class="mt-3 h-2 bg-slate-100 dark:bg-slate-800 rounded-full overflow-hidden">
        <div class="h-full bg-gradient-to-r from-violet-500 to-violet-700" style="width: {{ coverage_pct }}%"></div>
      </div>
    </div>
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-5 shadow-sm">
      <div class="text-xs uppercase tracking-wide text-slate-500 dark:text-slate-400">HTTP 入口</div>
      <div class="mt-2 text-3xl font-bold tracking-tight">{{ routes_count }}</div>
      <div class="text-xs text-slate-500 dark:text-slate-400 mt-1">个路由 / 接口</div>
    </div>
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-5 shadow-sm">
      <div class="text-xs uppercase tracking-wide text-slate-500 dark:text-slate-400">高危依赖</div>
      <div class="mt-2 flex items-baseline gap-2">
        <span class="text-3xl font-bold tracking-tight {% if deps_risk_count > 0 %}text-rose-600{% endif %}">{{ deps_risk_count }}</span>
        <span class="text-xs text-slate-500 dark:text-slate-400">/ 共 {{ deps_count }} 个第三方依赖</span>
      </div>
    </div>
  </div>
</section>