{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-audit-skill/schemas/finding.json",
  "title": "CodeAuditSkill Finding",
  "description": "Single vulnerability finding produced by CodeAuditSkill. Field names are aligned with pentestskill where overlapping, with code-audit specific additions (file_path, file_line, call_chain, language, framework).",
  "type": "object",
  "required": ["id", "title", "severity", "file_path", "language"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^FND-[0-9]{4,}$"
    },
    "title": {
      "type": "string",
      "minLength": 5,
      "maxLength": 200
    },
    "severity": {
      "type": "string",
      "enum": ["Critical", "High", "Medium", "Low", "Informational"]
    },
    "cvss_score": { "type": "number", "minimum": 0, "maximum": 10 },
    "cvss_vector": { "type": "string", "pattern": "^CVSS:3\\.1/" },
    "exploitability": {
      "type": "string",
      "enum": ["Trivial", "Easy", "Medium", "Hard", "Theoretical"]
    },
    "impact": {
      "type": "string",
      "enum": ["Catastrophic", "Major", "Moderate", "Minor", "Negligible"]
    },
    "confidence": {
      "type": "string",
      "enum": ["Confirmed", "High", "Medium", "Low"]
    },
    "category": { "type": "string" },
    "owasp_2021": { "type": "string", "pattern": "^A(0[1-9]|10):2021$" },
    "owasp_api_2023": { "type": "string", "pattern": "^API[0-9]+:2023$" },
    "cwe": {
      "type": "array",
      "items": { "type": "string", "pattern": "^CWE-[0-9]+$" }
    },
    "cve": {
      "type": "array",
      "items": { "type": "string" }
    },
    "asset_id": { "type": "string", "pattern": "^AST-[0-9]{4,}$" },

    "language": {
      "type": "string",
      "enum": ["java", "kotlin", "scala", "groovy",
               "python", "php", "javascript", "typescript",
               "go", "ruby", "csharp", "rust",
               "vue", "react", "angular", "svelte",
               "html", "css", "sql",
               "yaml", "json", "toml", "ini", "plaintext"]
    },
    "framework": {
      "type": "string",
      "description": "Framework, e.g. spring-boot, django, express, gin, rails"
    },
    "file_path": {
      "type": "string",
      "description": "Relative path to the source file"
    },
    "file_line": {
      "type": "integer",
      "minimum": 1
    },
    "file_offset": { "type": "integer", "minimum": 0 },
    "code_snippet": {
      "type": "string",
      "description": "The vulnerable code, max 30 lines, redacted secrets"
    },
    "code_before": { "type": "string" },
    "code_after": { "type": "string" },
    "code_language": {
      "type": "string",
      "description": "Prism language hint: java, python, javascript, etc."
    },
    "call_chain": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "line", "symbol"],
        "properties": {
          "file": { "type": "string" },
          "line": { "type": "integer", "minimum": 1 },
          "symbol": { "type": "string" },
          "snippet": { "type": "string" }
        }
      }
    },

    "url_or_path": {
      "type": "string",
      "description": "HTTP path/URL where this finding can be triggered. Aligned with pentestskill for cross-report correlation."
    },
    "method": {
      "type": "string",
      "enum": ["GET", "POST", "PUT", "DELETE", "PATCH", "HEAD", "OPTIONS", "WS", "GRAPHQL", "N/A"]
    },
    "parameter": {
      "type": "string",
      "description": "Vulnerable parameter name, aligned with pentestskill for cross-report correlation"
    },
    "vuln_class": {
      "type": "string",
      "enum": [
        "sqli", "nosqli", "ldap", "xpath",
        "xss-reflected", "xss-stored", "xss-dom",
        "ssrf", "open-redirect", "header-injection",
        "ssti", "ognl-injection", "spel-injection", "el-injection",
        "cmdi", "code-injection", "expression-injection",
        "file-read", "file-write", "file-upload", "path-traversal", "zip-slip",
        "deserialization-java", "deserialization-php", "deserialization-python",
        "deserialization-nodejs", "deserialization-golang", "deserialization-ruby",
        "xxe", "xinclude",
        "idor", "bola", "bfla", "missing-auth", "auth-bypass",
        "jwt-vuln", "session-fixation", "csrf", "clickjacking", "cors-misconfig",
        "race-condition", "toctou", "mass-assignment", "replay",
        "missing-security-header", "debug-mode-enabled", "default-credentials",
        "hardcoded-secret", "weak-crypto", "insecure-random",
        "dangerous-deps", "log4shell", "spring4shell",
        "prototype-pollution", "regex-dos", "weak-tls",
        "business-logic", "info-leak", "misconfig"
      ]
    },

    "discovered_at": { "type": "string", "format": "date-time" },
    "verified_at": { "type": "string", "format": "date-time" },
    "verified_by": {
      "type": "string",
      "enum": ["taint-trace", "manual-review", "framework-default", "snippet-infer", "human-required"]
    },

    "description": { "type": "string" },
    "business_impact": { "type": "string" },
    "attacker_capability": { "type": "string" },
    "reproduction_steps": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },

    "evidence": {
      "type": "object",
      "properties": {
        "vulnerable_code": { "type": "string" },
        "context_before": { "type": "string" },
        "context_after": { "type": "string" },
        "poc_curl": { "type": "string" },
        "poc_python": { "type": "string" },
        "poc_javascript": { "type": "string" },
        "poc_java": { "type": "string" },
        "poc_unit_test": { "type": "string" }
      }
    },

    "remediation": {
      "type": "object",
      "required": ["summary"],
      "properties": {
        "summary": { "type": "string" },
        "code_before": { "type": "string" },
        "code_after": { "type": "string" },
        "config": { "type": "string" },
        "reference": { "type": "string", "format": "uri" },
        "owasp_cheatsheet": { "type": "string" }
      }
    },

    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },

    "snippet_mode": {
      "type": "boolean",
      "description": "True if this finding was produced in snippet mode (no call chain context)"
    },
    "partial": {
      "type": "boolean",
      "description": "True if audit was incomplete (token budget exceeded)"
    },
    "human_review": {
      "type": "boolean"
    },
    "review_notes": { "type": "string" },

    "source": {
      "type": "string",
      "enum": ["local", "git", "archive", "snippet", "diff"],
      "description": "Audit input source"
    },
    "base_commit": { "type": "string" },
    "head_commit": { "type": "string" }
  }
}
