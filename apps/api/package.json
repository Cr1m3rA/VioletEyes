{
  "name": "@violeteyes/api",
  "version": "0.1.0",
  "private": true,
  "description": "VioletEyes-neo NestJS API server",
  "license": "Authorized-Testing-Only",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "nest build",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings 0",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "@nestjs/bullmq": "^10.2.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/platform-socket.io": "^10.4.0",
    "@nestjs/websockets": "^10.4.0",
    "@openai/agents": "^0.12.0",
    "@violeteyes/report-theme": "workspace:*",
    "@violeteyes/shared": "workspace:*",
    "@violeteyes/skill-schema": "workspace:*",
    "@willsoto/nestjs-prometheus": "^6.1.0",
    "adm-zip": "^0.5.16",
    "argon2": "^0.44.0",
    "better-sqlite3": "^12.0.0",
    "bull-board-api": "^8.0.0",
    "bull-board-express": "^8.0.0",
    "bullmq": "^5.79.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.0",
    "express": "^5.0.0",
    "ioredis": "^5.11.0",
    "multer": "^2.2.0",
    "openai": "^6.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino": "^9.0.0",
    "pino-http": "^10.0.0",
    "prom-client": "^15.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "socket.io": "^4.8.0",
    "yauzl": "^3.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.0",
    "@types/adm-zip": "^0.5.7",
    "@types/bull": "^4.10.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/yauzl": "^2.10.3",
    "@vitest/coverage-v8": "^2.1.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}