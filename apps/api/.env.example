# VioletEyes-neo API env (example — copy to .env and fill in)

# ── Server ─────────────────────────────────
NODE_ENV=development
PORT=3030
HOST=0.0.0.0
LOG_LEVEL=info

# ── Storage ────────────────────────────────
DATABASE_URL=./storage/violeteyes.db
STORAGE_DIR=./storage
CODE_VERSION_DIR=./storage/code-versions
SKILL_BUNDLE_DIR=./storage/skills
REPORT_DIR=./storage/reports

# ── Templates ──────────────────────────────
# VioletEyes Jinja2 templates (Phase 0 doc: apps/api/REPORT_TEMPLATES.md)
TEMPLATES_DIR=../../templates

# ── Secrets (MUST be high-entropy 32+ chars) ──
# Generate via: openssl rand -hex 32
JWT_SECRET=please-replace-with-32-char-random-hex-please-replace
APP_MASTER_KEY=please-replace-with-32-char-random-hex-please-replace
SESSION_SECRET=please-replace-with-32-char-random-hex-please-replace

# ── Auth ───────────────────────────────────
ACCESS_TOKEN_MS=900000           # 15 min (matches spec §8.5)
REFRESH_TOKEN_MS=604800000       # 7 days
COOKIE_SECURE=false              # true in production

# ── AI ─────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_DEFAULT_MODEL=claude-opus-4-8
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_DEFAULT_MODEL=gpt-4o

# ── Scan ───────────────────────────────────
SCAN_MAX_CONCURRENT=3
SCAN_TIMEOUT_MS=86400000         # 24h

# ── Redis ──────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── CORS ───────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:8090

# ── Bull-Board (admin only) ────────────────
BULL_BOARD_BASIC_USER=admin
BULL_BOARD_BASIC_PASSWORD=please-replace-with-strong-password