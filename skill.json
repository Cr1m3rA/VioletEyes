{
  "name": "code-audit-skill",
  "version": "1.0.0",
  "description": "AI Agent 驱动的多语言源码安全审计 Skill。覆盖前后端主流框架与不完整代码片段，输出与 pentestskill 视觉风格一致的 HTML 报告。",
  "author": "code-audit-skill",
  "license": "Authorized-Testing-Only",
  "entry": "SKILL.md",
  "framework_compatibility": [
    "claude-code",
    "cline",
    "roo-code",
    "continue",
    "cursor",
    "aider"
  ],
  "mcp": {
    "required": [],
    "optional": [
      {
        "name": "semgrep",
        "purpose": "可选：调用本地 semgrep 引擎做第一轮 sink/source 扫描加速"
      },
      {
        "name": "codeql",
        "purpose": "可选：调用 CodeQL 做深度数据流分析"
      }
    ],
    "auto_detect": false
  },
  "permissions": {
    "network": [],
    "filesystem": ["read_source", "write_report"],
    "execution": ["python3"]
  },
  "inputs": {
    "source": { "type": "string", "required": true, "description": "本地目录 / Git URL / 压缩包 / 文本片段" },
    "mode": { "type": "string", "default": "full", "enum": ["full", "incremental", "snippet", "api-focused", "frontend-focused", "diff"] },
    "languages": { "type": "array", "default": [], "items": { "type": "string" } },
    "scope": { "type": "array", "default": [] },
    "focus": { "type": "array", "default": [] },
    "severity_floor": { "type": "string", "default": "low", "enum": ["info", "low", "medium", "high", "critical"] },
    "max_findings": { "type": "integer", "default": 100 },
    "report_path": { "type": "string", "default": "./code-audit-report.html" },
    "include_snippet": { "type": "boolean", "default": true },
    "token_budget": { "type": "integer", "default": 200000 }
  },
  "outputs": {
    "report": "HTML 源码审计报告",
    "findings": "JSON 漏洞清单",
    "assets": "JSON 代码资产清单",
    "framework_profile": "JSON 语言/框架/入口画像",
    "execution_log": "TXT Agent 步进日志"
  },
  "supported_languages": [
    "java", "kotlin", "scala", "groovy",
    "python", "python-asyncio",
    "php",
    "javascript", "typescript",
    "go",
    "ruby",
    "csharp", "aspnet",
    "rust",
    "vue", "react", "angular", "svelte",
    "html", "css",
    "sql",
    "yaml", "json", "toml", "ini"
  ],
  "supported_frameworks": {
    "java_backend": [
      "spring-boot", "spring-mvc", "spring-webflux",
      "quarkus", "micronaut", "helidon",
      "jfinal", "nutz", "dubbo",
      "struts2", "jsf", "gwt"
    ],
    "python_backend": [
      "django", "flask", "fastapi", "tornado", "sanic", "aiohttp",
      "bottle", "pyramid", "falcon", "starlette"
    ],
    "php_backend": [
      "laravel", "symfony", "thinkphp", "yii", "codeigniter",
      "slim", "lumen", "phalcon", "discuz", "wordpress", "typecho"
    ],
    "nodejs_backend": [
      "express", "koa", "fastify", "nestjs", "hapi", "egg",
      "sails", "loopback", "restify", "polka"
    ],
    "go_backend": [
      "gin", "echo", "fiber", "beego", "iris", "chi",
      "revel", "buffalo", "kratos"
    ],
    "ruby_backend": ["rails", "sinatra", "hanami", "grape"],
    "csharp_backend": ["aspnet-mvc", "aspnet-core", "webapi", "nancyfx", "service-stack"],
    "frontend": [
      "vue", "vue2", "vue3", "nuxt", "vuex", "pinia",
      "react", "next", "gatsby", "redux", "mobx", "zustand",
      "angular", "angularjs", "ionic",
      "svelte", "sveltekit",
      "jquery", "backbone", "ember",
      "electron", "tauri"
    ]
  },
  "vulnerability_classes": [
    "sqli", "nosqli", "ldap", "xpath", "cmdi", "code-injection",
    "xss-reflected", "xss-stored", "xss-dom", "xss-misuse",
    "ssrf", "open-redirect", "header-injection",
    "ssti", "expression-injection",
    "file-read", "file-write", "file-upload", "path-traversal", "zip-slip",
    "deserialization-java", "deserialization-php", "deserialization-python", "deserialization-nodejs", "deserialization-golang",
    "xxe", "xinclude",
    "idor", "bola", "broken-function-level-authz", "missing-auth",
    "auth-bypass", "weak-crypto", "insecure-random", "hardcoded-secret",
    "jwt-vuln", "session-fixation", "csrf", "clickjacking", "cors-misconfig",
    "race-condition", "toctou", "mass-assignment",
    "log4shell", "spring4shell", "log4j-rce", "log4j-format", "ognl-injection", "el-injection", "spel-injection",
    "prototype-pollution", "regex-dos", "xxe-via-upload",
    "missing-security-header", "debug-mode-enabled", "default-credentials",
    "dangerous-deps", "insecure-config", "weak-tls",
    "business-logic", "info-leak"
  ],
  "capabilities": {
    "framework_detection": true,
    "entry_point_discovery": true,
    "incremental_code_reading": true,
    "sink_pattern_matching": true,
    "taint_propagation_llm": true,
    "snippet_mode": true,
    "multi_language": true,
    "multi_framework": true,
    "html_reporting": true,
    "owasp_mapping": true,
    "cwe_mapping": true,
    "cvss_scoring": true,
    "pentestskill_integration": true
  }
}
